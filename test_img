from enum import Enum
from pydantic import BaseModel, ConfigDict, Field, field_validator
from typing import Annotated, Any, List, Literal, Optional, Union



class StrictModel(BaseModel):
    model_config = ConfigDict(
        extra="forbid",
        validate_assignment=True,
    )

class LoadDeltaBatchConfig(StrictModel):
    size: int = Field(gt=0)

class BasePathConfig(StrictModel):
    domain: str
    schema_name: str = Field(alias="schema")
   
class PathConfig(BasePathConfig):
    name: str

class CheckpointConfig(StrictModel):
    path: PathConfig

class LoadDeltaConfig(StrictModel):
    strategy: Literal["delta"]
    # Se não for informado, pega todas as partições de uma vez.
    batch: LoadDeltaBatchConfig | None = None

class LoadFullConfig(StrictModel):
    strategy: Literal["full"]

LoadConfig = Annotated[
    LoadDeltaConfig | LoadFullConfig,
    Field(discriminator="strategy"),
]

class SourceConfig(StrictModel):
    alias: str
    load: LoadConfig
    path: PathConfig

class TargetConfig(StrictModel):
    base_path: BasePathConfig

class SmartCslConfig(StrictModel):
    checkpoint: CheckpointConfig | None = None
    sources: list[SourceConfig]
    target: TargetConfig

    @field_validator("checkpoint", mode = "before")
    @classmethod
    def checkpoint_validator_before(cls, value, info) -> dict:
        path = value["path"]
        if ("layer" in path):
            domain, schema = info.context["layer_mapper"][path["layer"]]
            path = {
                "domain": domain,
                "schema": schema,
                "name": path["name"]
            }

        return {
            **value,
            "path": path
        }

    @field_validator("target", mode = "before")
    @classmethod
    def target_validator_before(cls, value, info) -> dict:
        base_path = value["base_path"]
        if ("layer" in base_path):
            domain, schema = info.context["layer_mapper"][base_path["layer"]]
            base_path = {
                "domain": domain,
                "schema": schema
            }

        return {
            **value,
            "base_path": base_path
        }



def cleanup_temp_objects(spark: SparkSession, verbose: bool = True) -> dict:
    """
    Dropa todas as temporary views e temporary functions da sessão.
    
    Args:
        spark: SparkSession ativa
        verbose: Se True, printa o que está sendo dropado
    
    Returns:
        Dict com contadores: {"views_dropped": int, "functions_dropped": int}
    """
    views_dropped = 0
    functions_dropped = 0
    
    # Lista e dropa todas as temporary views
    try:
        temp_views = [v.name for v in spark.catalog.listTables() if v.isTemporary]
        
        for view_name in temp_views:
            try:
                spark.catalog.dropTempView(view_name)
                views_dropped += 1
                if verbose:
                    print(f"✓ Dropped temp view: {view_name}")
            except Exception as e:
                if verbose:
                    print(f"✗ Failed to drop temp view {view_name}: {e}")
    except Exception as e:
        if verbose:
            print(f"✗ Failed to list temp views: {e}")
    
    # Lista e dropa todas as temporary functions
    try:
        temp_functions = [f['function'] for f in spark.sql("SHOW USER FUNCTIONS LIKE '*'").collect()]
        
        for func_name in temp_functions:
            try:
                spark.sql(f"DROP TEMPORARY FUNCTION IF EXISTS {func_name}")
                functions_dropped += 1
                if verbose:
                    print(f"✓ Dropped temp function: {func_name}")
            except Exception as e:
                if verbose:
                    print(f"✗ Failed to drop temp function {func_name}: {e}")
    except Exception as e:
        if verbose:
            print(f"✗ Failed to list temp functions: {e}")
    
    result = {
        "views_dropped": views_dropped,
        "functions_dropped": functions_dropped
    }
    
    if verbose:
        print(f"\n📊 Summary: {views_dropped} views, {functions_dropped} functions dropped")
    
    return result




