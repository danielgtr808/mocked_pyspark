from pyspark.sql import DataFrame, functions as f, Row, SparkSession
from typing import Generator



def build_table_path(path_config: PathConfig) -> str:
    return f"{path_config.domain}.{path_config.schema_name}.{path_config.name}"

def calculate_delta(spark_session: SparkSession, table_path: PathConfig, checkpoint_config: CheckpointConfig) -> DataFrame:
    source_partitions: DataFrame = spark_session.sql(f"show partitions {build_table_path(table_path)}")

    if (not table_exists(spark_session, checkpoint_config.path)):
        return source_partitions
    
    checkpoint: DataFrame = spark_session.table(build_table_path(checkpoint_config.path))
    common_columns: List[str] = get_common_columns(source_partitions, checkpoint)

    return (
        source_partitions
        .join(
            checkpoint,
            how = "leftanti",
            on = common_columns
        )
        .select(
            source_partitions["*"]
        )
    )

def get_common_columns(data_frame_1: DataFrame, data_frame_2: DataFrame) -> List[str]:
    return list(set(data_frame_1.columns) & set(data_frame_2.columns))

def divide_data_frame_into_batches(spark_session: SparkSession, data_frame_to_divide: DataFrame, batch_size: int) -> Generator[DataFrame, None, None]:
    partitions: list[Row] = (
        data_frame_to_divide
        .orderBy(
            *[f.asc(c) for c in data_frame_to_divide.columns]
        )
        .collect()
    )

    for index in range(0, len(partitions), batch_size):
        yield (
            spark_session
            .createDataFrame(
                data = partitions[index:index+batch_size],
                schema = data_frame_to_divide.schema
            )
        )

def table_exists(spark_session: SparkSession, path_config: PathConfig) -> bool:
    table_path = build_table_path(path_config)
    return spark_session.catalog.tableExists(table_path)

def sql_runner(
    sql_to_run: str,
    spark_session: SparkSession,
    views_to_register: dict[str, DataFrame],
    target_path_config: TargetPathConfig
) -> None:
    try:
        for alias, data in views_to_register.items():
            data.createOrReplaceTempView(alias)

        sql: str = f"use catalog pr_{target_path_config.domain};"
        print(f"Executando o SQL: {sql}.")
        spark_session.sql(sql)
        
        sql: str = f"use schema {target_path_config.schema_name};"
        print(f"Executando o SQL: {sql}.")
        spark_session.sql(sql)
        
        print(f"Executando o SQL:\n{sql_to_run}")
        spark_session.sql(sql_to_run)

    finally:
        for alias in views_to_register.keys():
            spark_session.catalog.dropTempView(alias)


