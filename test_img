        partitions_to_ingest: DataFrame = calculate_delta(spark_session, source.path, smart_csl_config.checkpoint.path)
        common_columns: List[str] = get_common_columns(source_dataframe, partitions_to_ingest)
        
        batches_generator: Generator[DataFrame, None, None]
        if (source.load.batch):
            batches_generator = divide_data_frame_into_batches(spark_session, partitions_to_ingest, source.load.batch.size)
