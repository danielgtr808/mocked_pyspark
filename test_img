def get_common_columns(data_frame_1: DataFrame, data_frame_2: DataFrame) -> List[str]:
    return list(set(data_frame_1.columns) & set(data_frame_2.columns))

def filter_partitions(
    sas: SparkAcessStrategy,
    partitions: DataFrame,
    checkpoint_config: CheckpointConfig
) -> DataFrame:
    p: PathConfig = checkpoint_config.path
    checkpoint_data_path: list[str] = [p.domain, p.schema_name, p.name]
    
    checkpoint: Optional[DataFrame] = sas.get_data_if_exists(data_path = checkpoint_data_path)
    if (checkpoint is None):
        print("Tabela controle não existe, retornado partições completas.")
        return partitions
    
    common_columns: List[str] = get_common_columns(partitions, checkpoint)

    return (
        partitions
        .join(
            checkpoint,
            how = "leftanti",
            on = common_columns
        )
        .select(
            partitions["*"]
        )
    )

def generate_partitions_batch(
    sas: SparkAcessStrategy,
    partitions: DataFrame,
    load_delta_config: LoadDeltaConfig
) -> Generator[DataFrame, None, None]:
    if load_delta_config.batch is None:
        yield partitions
        return

    partitions_rows: list[Row] = (
        partitions
        .orderBy(
            [f.asc(c) for c in partitions.columns]
        )
        .collect()
    )
    rows_schema: t.StructType = partitions.schema

    for i in range(0, len(partitions_rows), load_delta_config.batch.size):
        yield (
            sas
            .spark_session
            .createDataFrame(
                data=partitions_rows[i:i+load_delta_config.batch.size],
                schema=rows_schema
            )
        )

def delta_path(
    sas: SparkAcessStrategy,
    checkpoint_config: CheckpointConfig,
    source_config: SourceConfig,
    load_delta_config: LoadDeltaConfig
) -> Generator[DataFrame, None, None]:
    p: PathConfig = source_config.path
    source_data_path: list[str] = [p.domain, p.schema_name, p.name]
    source_data: DataFrame = sas.get_data(data_path = source_data_path)
    source_partitions: DataFrame = filter_partitions(
        sas,
        sas.get_data_partitions(data_path = source_data_path),
        checkpoint_config
    )

    for partition_batch in generate_partitions_batch(
        sas,
        source_partitions,
        load_delta_config
    ):
        print(partition_batch.collect())
        common_columns: List[str] = get_common_columns(source_data, partition_batch)
        print("common_columns:", common_columns)
        yield (
            source_data
            .join(
                partition_batch,
                how = "inner",
                on = common_columns
            )
            .select(
                source_data["*"]
            )

        )
        
    return

def full_path(
    sas: SparkAcessStrategy,
    checkpoint_config: CheckpointConfig,
    source_config: SourceConfig,
