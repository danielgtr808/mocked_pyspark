                transform_and_write_sql,
                spark_session,
                {
                    source.alias: source_delta,
                    "__current_partitions": batch
                },
                smart_csl_config.target,
                
            )
    else:
        sql_runner(
            transform_and_write_sql,
            spark_session,
            {
                source.alias: source_delta
            },
            smart_csl_config.target,
